[Unit]
Description=LASO Orchestration Framework
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=laso
Group=laso
ExecStart=/usr/local/bin/laso-server --config /etc/laso/laso.yaml
WorkingDirectory=/var/lib/laso
Environment=LASO_DATA_DIR=/var/lib/laso
Environment=LASO_JSON_LOGS=true
StateDirectory=laso
StateDirectoryMode=0700
LogsDirectory=laso
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/laso
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
